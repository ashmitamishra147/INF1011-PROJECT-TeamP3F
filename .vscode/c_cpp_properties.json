{
  "version": 4,
  "env": {
    "arduino15": "C:/Users/jyuhn/AppData/Local/Arduino15/packages",
    "tcSamd": "C:/Users/jyuhn/AppData/Local/Arduino15/packages/TinyCircuits/hardware/samd/1.1.0"
  },
  "configurations": [
    {
      "name": "TinyScreen+",
      "compilerPath": "${arduino15}/arduino/tools/arm-none-eabi-gcc/7-2017q4/bin/arm-none-eabi-g++.exe",
      "compilerArgs": ["-mcpu=cortex-m0plus", "-mthumb"],
      "intelliSenseMode": "gcc-arm",
      "includePath": [
        "${workspaceFolder}/**",
        "${tcSamd}/cores/arduino",
        "${tcSamd}/variants/tinyscreen_p",
        "${tcSamd}/libraries/**",
        "${arduino15}/arduino/tools/CMSIS/4.5.0/CMSIS/Include",
        "${arduino15}/arduino/tools/CMSIS-Atmel/1.2.0/CMSIS/Device/ATMEL",
        "C:/Users/jyuhn/OneDrive/Documents/Arduino/libraries/**"
      ],
      "forcedInclude": ["${tcSamd}/cores/arduino/Arduino.h"],
      "defines": [
        "F_CPU=48000000L",
        "ARDUINO=10607",
        "ARDUINO_SAMD_ZERO",
        "ARDUINO_ARCH_SAMD",
        "__SAMD21G18A__",
        "USBCON",
        "USB_VID=0x03EB",
        "USB_PID=0x8009"
      ],
      "cStandard": "gnu11",
      "cppStandard": "gnu++11"
    }
  ]
}
